---
import BaseLayout from "../../layouts/baseLayout.astro";
import ProjectEntry from "../../components/projectentry.astro";
import { getCollection } from "astro:content";

import "../../styles/brain.css";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Suriyaa Kumar | Brain"
  description="Selected engineering projects, experiments, and technical work."
>
  <main class="brain">
    <header class="log-header">
      <span>LOG // S3L3CT3D_W0RK</span>
      <span>{String(projects.length).padStart(2, "0")} ENTRIES</span>
    </header>

    <div class="projects">
      {
        projects.map((project, index) => (
          <ProjectEntry project={project} index={index + 1} />
        ))
      }
    </div>

    <footer class="brain-footer">
      <a
        href="https://github.com/suriyaakumar"
        target="_blank"
        rel="noopener noreferrer"
      >
        [EXPLORE ALL REPOSITORIES ↗]
      </a>
    </footer>
  </main>
</BaseLayout>
