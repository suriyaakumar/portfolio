---
import BaseLayout from "../layouts/baseLayout.astro";
import { Image } from "astro:assets";
import portrait from "../image.png";
import "../styles/face.css";

interface Field {
	key: string;
	value: string;
}

interface Experience {
	org: string;
	role: string;
	period: string;
	stack: string[];
	details: string[];
}

interface Contact {
	key: string;
	value: string;
	href: string;
}

const identity: Field[] = [
	{ key: "NAME", value: "Suriyaa Kumar" },
	{ key: "A/S/L", value: "26 / M / Chennai" },
	{ key: "ROLE", value: "Software Engineer" },
	{ key: "FOCUS", value: "Backend systems · APIs · Full-stack" },
	{ key: "BEYOND", value: "Music, games, anime, writing & the internet" },
];

const experiences: Experience[] = [
	{
		org: "Comcast",
		role: "Software Development Engineer - II",
		period: "09.2024 — Present",
		stack: ["React", "TypeScript", "Node.js", "Azure", "AWS"],
		details: [
			"Built reusable TypeScript services and conversational infrastructure for customer-facing chat and voice experiences.",
			"Developed API-driven self-service workflows across order tracking, billing, refunds, streaming, and telecommunications.",
			"Implemented CI/CD and release-validation infrastructure for production delivery.",
		],
	},
	{
		org: "Cloudify",
		role: "Software Developer",
		period: "08.2021 — 03.2024",
		stack: ["TypeScript", "Next.js", "React", "AWS", "tRPC"],
		details: [
			"Built full-stack B2B SaaS integrations serving 25+ European customers.",
			"Developed reusable CRM, ERP, payments, and e-commerce connectors, reducing repeated implementation effort by approximately 70%.",
			"Built event-driven AWS Lambda and SQS workflows for orders, subscriptions, and invoicing.",
		],
	},
];

const contacts: Contact[] = [
	{
		key: "EMAIL",
		value: "believeinsurya@gmail.com",
		href: "mailto:believeinsurya@gmail.com",
	},
	{
		key: "GITHUB",
		value: "github.com/suriyaakumar",
		href: "https://github.com/suriyaakumar",
	},
	{
		key: "LINKEDIN",
		value: "linkedin.com/in/suriyaakumar",
		href: "https://linkedin.com/in/suriyaakumar",
	},
	{
		key: "RSS",
		value: "Subscribe to HEART",
		href: "/rss.xml",
	},
];
---

<BaseLayout
	title="Suriyaa Kumar | Face"
	description="Software engineer specializing in TypeScript, backend systems, integrations, and full-stack development."
>
	<div class="face">
		<!-- WHOIS -->
		<section class="profile" aria-labelledby="identity-heading">
			<div class="portrait">
				<Image src={portrait} alt="Suriyaa Kumar" priority />
			</div>

			<div class="identity">
				<header class="section-header">
					<h1 id="identity-heading">LOG // WH01S</h1>
					<span>PROFILE LOADED</span>
				</header>

				<div class="fields">
					{
						identity.map(({ key, value }) => (
							<div class="field">
								<span class="key">[{key}]</span>
								<span class="value">{value}</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<!-- WORK EXPERIENCE -->
		<section class="work" aria-labelledby="experience-heading">
			<header class="section-header">
				<h2 id="experience-heading">LOG // WRK_3XP</h2>
				<span
					>{String(experiences.length).padStart(2, "0")} ENTRIES</span
				>
			</header>

			<ol class="work-list">
				{
					experiences.map((entry, index) => (
						<li class="work-entry">
							<div class="work-heading">
								<h3>
									<span
										class="work-prompt"
										aria-hidden="true"
									>
										&gt;
									</span>
									<span class="work-number">
										{String(index + 1).padStart(2, "0")} /
									</span>
									<span class="work-title">{entry.org}</span>
								</h3>

								<span class="work-period">{entry.period}</span>
							</div>

							<div class="work-body">
								<p class="work-subtitle">{entry.role}</p>
								<p class="work-description">
									{entry.details[0]}
								</p>

								<div class="work-meta">
									<span>[STACK]</span>
									<span>{entry.stack.join(" · ")}</span>
								</div>

								<div class="work-engineering">
									<span class="engineering-label">
										[ENGINEERING]
									</span>
									<ul>
										{entry.details
											.slice(1)
											.map((detail) => (
												<li>{detail}</li>
											))}
									</ul>
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<!-- REACH -->
		<section class="contact" id="contact" aria-labelledby="contact-heading">
			<header class="section-header">
				<h2 id="contact-heading">LOG // R34CH</h2>
				<span>OPEN CHANNELS</span>
			</header>

			<div class="fields">
				<div class="contact-group">
					<div class="field">
						<span class="key">[STATUS]</span>
						<span class="value"
							>Open to software engineering opportunities</span
						>
					</div>
					<div class="field">
						<span class="key">[TIME]</span>
						<span class="value"
							>IST (UTC+05:30) · Usually replies within 24h</span
						>
					</div>
				</div>

				<div class="contact-group">
					{
						contacts.map(({ key, value, href }) => (
							<div class="field">
								<span class="key">[{key}]</span>
								<a
									class="value contact-link"
									href={href}
									target={
										href.startsWith("https://")
											? "_blank"
											: undefined
									}
									rel={
										href.startsWith("https://")
											? "noopener noreferrer"
											: undefined
									}
								>
									{value}
									<span aria-hidden="true">↗</span>
								</a>
							</div>
						))
					}

					<div class="field">
						<span class="key">[RESUME]</span>
						<div class="resume-actions">
							<button
								id="resume-preview"
								class="resume-link"
								type="button"
								aria-haspopup="dialog"
								aria-controls="resume-dialog"
							>
								[PREVIEW ↗]
							</button>

							<a
								href="/resume.pdf"
								download="Suriyaa_Kumar_Resume.pdf"
								class="resume-link"
							>
								[DOWNLOAD ↓]
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- RESUME PREVIEW -->
		<dialog
			id="resume-dialog"
			class="resume-dialog"
			aria-labelledby="resume-title"
		>
			<header class="resume-header">
				<h2 id="resume-title">LOG // R3SUM3</h2>
				<div class="resume-controls">
					<a href="/resume.pdf" download="Suriyaa_Kumar_Resume.pdf">
						[DOWNLOAD ↓]
					</a>
					<form method="dialog">
						<button type="submit" autofocus>[CLOSE ×]</button>
					</form>
				</div>
			</header>

			<iframe
				src="/resume.pdf"
				title="Suriyaa Kumar — Résumé"
				class="resume-viewer"
				loading="lazy"></iframe>

			<footer class="resume-footer">
				<span>DOCUMENT // PDF</span>
				<a href="/resume.pdf" target="_blank" rel="noopener noreferrer">
					[OPEN EXTERNALLY ↗]
				</a>
			</footer>
		</dialog>
	</div>
</BaseLayout>

<script>
	function initializeResumePreview() {
		const button =
			document.querySelector<HTMLButtonElement>("#resume-preview");
		const dialog =
			document.querySelector<HTMLDialogElement>("#resume-dialog");

		if (!button || !dialog) return;

		button.onclick = () => {
			if (!dialog.open) dialog.showModal();
		};

		dialog.onclick = (event) => {
			if (event.target !== dialog) return;

			const rect = dialog.getBoundingClientRect();
			const outside =
				event.clientX < rect.left ||
				event.clientX > rect.right ||
				event.clientY < rect.top ||
				event.clientY > rect.bottom;

			if (outside) dialog.close();
		};
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initializeResumePreview, {
			once: true,
		});
	} else {
		initializeResumePreview();
	}

	document.addEventListener("astro:page-load", initializeResumePreview);
</script>
