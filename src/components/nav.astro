---
import "../styles/nav.css";

const path = Astro.url.pathname;

const sectionLinks = [
  { label: "FACE", href: "/" },
  { label: "BRAIN", href: "/brain" },
  { label: "HEART", href: "/heart" },
  { label: "MEMORY", href: "/memory" },
];

function isActive(href: string) {
  if (href === "/") return path === "/";

  return path === href || path.startsWith(`${href}/`);
}
---

<nav class="nav-island" aria-label="Site navigation">
  <div class="links">
    {
      sectionLinks.map((link) => {
        const active = isActive(link.href);

        return (
          <a
            href={link.href}
            class:list={["link", { active }]}
            aria-current={active ? "page" : undefined}
          >
            {active ? `[${link.label}]` : link.label}
          </a>
        );
      })
    }
  </div>
</nav>

<script>
  const navs = document.querySelectorAll<HTMLElement>(".nav-island");

  let scrollTimeout: ReturnType<typeof setTimeout>;

  function toggleNav(hidden: boolean) {
    navs.forEach((nav) => {
      nav.classList.toggle("nav-hidden", hidden);
    });
  }

  window.addEventListener(
    "scroll",
    () => {
      clearTimeout(scrollTimeout);

      if (window.scrollY < 80) {
        toggleNav(false);
        return;
      }

      toggleNav(true);

      scrollTimeout = setTimeout(() => {
        toggleNav(false);
      }, 100);
    },
    { passive: true },
  );
</script>
