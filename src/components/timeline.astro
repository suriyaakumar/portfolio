---
import "../styles/timeline.css";

// TelemetryTimeline.astro
// Vertical rail + telemetry log entries branching off each node.

export interface LogEntry {
  period: string;
  status?: string;
  role: string;
  org: string;
  stack?: string[];
  detail: string[];
}

interface Props {
  entries?: LogEntry[];
}

const {
  entries = [
    {
      period: "09.2024 — Present",
      role: "Software Development Engineer - II",
      org: "Comcast",
      stack: ["React", "TypeScript", "Node.js", "Microsoft Azure", "AWS"],
      detail: [
        "Expanded customer self-service across web chat and IVR voice, covering order tracking, billing, refunds, streaming and mobile journeys.",
        "Built reusable TypeScript services and conversational infrastructure that reduced duplicated implementation across customer flows.",
        "Integrated backend APIs, shared routing and state mechanisms to support complex multi-step customer interactions across product domains.",
        "Strengthened production delivery through CI/CD and release-validation work for customer-facing conversational features.",
      ],
    },
    {
      period: "08.2021 — 03.2024",
      role: "Software Developer",
      stack: [
        "AWS SST",
        "React",
        "Next.js",
        "Tailwind",
        "TypeScript",
        "Planetscale",
        "DrizzleORM",
        "TRPC",
      ],
      org: "Cloudify",
      detail: [
        "Built full-stack B2B SaaS features with TypeScript, Next.js, tRPC and AWS for 25+ European customers.",
        "Developed reusable CRM, ERP, payments and e-commerce connectors that cut repeated integration effort by roughly 70%.",
        "Built event-driven Lambda and SQS workflows supporting orders, subscriptions and invoicing across customer integrations.",
        "Designed validation and data-handling flows across 50k+ integration records while helping scale onboarding and connector delivery.",
      ],
    },
  ],
} = Astro.props;
---

<div class="telemetry">
  <div class="log-header">
    <span>LOG // WRK_3XP</span>
    <span>{entries.length} {entries.length === 1 ? "ENTRY" : "ENTRIES"}</span>
  </div>

  <ol class="rail">
    {
      entries.map((entry) => (
        <li class="log-entry">
          <span class="node" aria-hidden="true" />

          <div class="log-line">
            <div class="log-line-left">
              <span class="prompt">&gt;</span>
              <span class="value">{entry.org.toUpperCase()}</span>
            </div>
            <span class="timestamp">{entry.period}</span>
          </div>

          <div class="log-body">
            <div class="field">
              <>
                <span class="key">[ROLE]</span>
                <span class="value">{entry.role}</span>
              </>
            </div>
            {entry.stack && (
              <div class="field">
                <span class="key">[STACK]</span>
                <div class="value">
                  {entry.stack.map((lang) => (
                    <span>[{lang}]</span>
                  ))}
                </div>
              </div>
            )}
            <div class="field">
              <>
                <span class="key">[NOTE]</span>
                <div class="value">
                  {entry.detail.map((detail) => (
                    <span>{detail}</span>
                  ))}
                </div>
              </>
            </div>
          </div>
        </li>
      ))
    }

    <li class="log-entry end">
      <span class="node end-node" aria-hidden="true"></span>
      <div class="log-line">
        <div class="log-line-left">
          <span class="prompt">&gt;</span>
          <span class="cursor">_</span>
        </div>
      </div>
    </li>
  </ol>
</div>
